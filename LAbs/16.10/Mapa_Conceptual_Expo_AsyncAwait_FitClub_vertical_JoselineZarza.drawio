        <mxCell id="B9" value="Promise.all (paralelo, falla si una rechaza) vs secuencial (tiempo T1+T2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;align=center;verticalAlign=middle;fillColor=#E0E7FF;strokeColor=#4338CA;fontColor=#1f2328;" vertex="1" parent="1">
