        <mxCell id="C12" value="Ejemplo 2 — Endpoint real verificado en Postman (PUT 200, DELETE 204, 404 y 409 probados)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="5440" y="660" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="C3" value="fetch: API de solicitudes HTTP que devuelve una Promise (la usa tu apiClient.ts)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;align=center;verticalAlign=middle;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#1f2328;" vertex="1" parent="1">
