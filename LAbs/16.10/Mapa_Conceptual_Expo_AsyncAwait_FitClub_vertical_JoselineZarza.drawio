        <mxCell id="B0" value="B · Modelo de ejecución: síncrono vs asíncrono" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;align=center;verticalAlign=middle;fillColor=#4338CA;strokeColor=#312693;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="3965" y="220" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="B1" value="Síncrono: una instrucción tras otra; puede bloquear la UI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;align=center;verticalAlign=middle;fillColor=#E0E7FF;strokeColor=#4338CA;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="3340" y="440" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="B2" value="Asíncrono: inicia operaciones que terminan después, sin bloquear la UI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;align=center;verticalAlign=middle;fillColor=#E0E7FF;strokeColor=#4338CA;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="4015" y="440" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="B3" value="Call stack y event loop coordinan la ejecución" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;align=center;verticalAlign=middle;fillColor=#E0E7FF;strokeColor=#4338CA;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="4540" y="440" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="B7" value="Secuencia 1 — console.log A, setTimeout 0ms B, Promise.then C, console.log D → orden real A, D, C, B" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;align=center;verticalAlign=middle;fillColor=#E0E7FF;strokeColor=#4338CA;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="4540" y="660" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="B8" value="Error conceptual: setTimeout(…, 0) no es ejecución inmediata" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;align=center;verticalAlign=middle;fillColor=#E0E7FF;strokeColor=#4338CA;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="4540" y="880" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="B4" value="Promise: pendiente, cumplida o rechazada (pending/fulfilled/rejected)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;align=center;verticalAlign=middle;fillColor=#E0E7FF;strokeColor=#4338CA;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="3790" y="660" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="B5" value="async (siempre devuelve Promise) y await (pausa la continuación local)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;align=center;verticalAlign=middle;fillColor=#E0E7FF;strokeColor=#4338CA;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="3790" y="880" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="B6" value="try / catch / finally: errores y limpieza (setLoading(false))" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;align=center;verticalAlign=middle;fillColor=#E0E7FF;strokeColor=#4338CA;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="3640" y="1100" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="B10" value="Error conceptual: await no bloquea por sí solo toda la aplicación" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;align=center;verticalAlign=middle;fillColor=#E0E7FF;strokeColor=#4338CA;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="3940" y="1100" width="260" height="70" as="geometry" />
